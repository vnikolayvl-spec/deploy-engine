{
  "packages": {
    "deploy-engine": {
      "version": "8.0.0",
      "desc": "Модульный кроссплатформенный оркестратор развертывания пакетов, резервного копирования и TUI-управления",
      "sys_packages": {
        "linux": [
          "curl",
          "tar"
        ],
        "apt": [
          "python3",
          "python3-venv",
          "python3-pip",
          "openssh-client"
        ],
        "dnf": [
          "python3",
          "python3-pip",
          "openssh-clients"
        ],
        "apk": [
          "python3",
          "py3-pip",
          "openssh-client"
        ],
        "pacman": [
          "python",
          "python-pip",
          "openssh"
        ],
        "brew": [
          "python3"
        ]
      },
      "dirs": [
        "{{DATA_DIR}}/packages",
        "{{DATA_DIR}}/backup",
        {
          "path": "{{DATA_DIR}}/env",
          "mode": "0700"
        }
      ],
      "include": [
        "deploy.env",
        "files",
        "deploy-engine.sh",
        "deploy-engine",
        "deploy-ui.sh",
        "deploy-ui"
      ]
    }
  },
  "units": {
    "deploy.env": {
      "type": "env",
      "desc": "Системная конфигурация оркестратора Deploy Engine",
      "dest": "/etc/default/de_deploy-engine/deploy-engine.env"
    },
    "files": {
      "type": "file",
      "desc": "Модульное Python-ядро и библиотеки оркестратора Deploy Engine",
      "dest": "/opt/de_deploy-engine/files"
    },
    "deploy-engine.sh": {
      "type": "script",
      "desc": "Системный CLI лаунчер оркестратора Deploy Engine",
      "dest": "{{SYS_BIN}}/deploy-engine.sh"
    },
    "deploy-engine": {
      "type": "symlink",
      "desc": "Символическая ссылка для вызова CLI deploy-engine без расширения .sh",
      "src": "{{SYS_BIN}}/deploy-engine.sh",
      "dest": "{{SYS_BIN}}/deploy-engine"
    },
    "deploy-ui.sh": {
      "type": "script",
      "desc": "Системный TUI лаунчер графической консоли Deploy Engine",
      "dest": "{{SYS_BIN}}/deploy-ui.sh"
    },
    "deploy-ui": {
      "type": "symlink",
      "desc": "Символическая ссылка для запуска TUI deploy-ui без расширения .sh",
      "src": "{{SYS_BIN}}/deploy-ui.sh",
      "dest": "{{SYS_BIN}}/deploy-ui"
    }
  }
}
