# ==============================================================================
# Шаблон локальной конфигурации Deploy Engine (app.env)
# Скопируйте этот файл в deploy-engine/app.env для переопределения настроек
# в автономном режиме. При установке движка как системного пакета конфигурация
# считывается из /etc/default/de_deploy-engine/deploy-engine.env
# ==============================================================================

# Базовый каталог динамических данных самого движка:
# - По умолчанию локально: папка запуска deploy-engine
# - При системной установке: /var/lib/de_deploy-engine
DE_DATA_DIR=""

# Каталог репозитория пакетов по умолчанию:
# - Локально: ./packages
# - При системной установке: /var/lib/de_deploy-engine/packages
DE_PACKAGES_DIR=""

# Файл кэша реестра пакетов:
# - Локально: packages.json
# - При системной установке: /var/lib/de_deploy-engine/packages.json
DE_PACKAGES_CACHE=""

# Папка хранения локальных пресетов окружения (.env):
# - Локально: <deploy-engine>/env
# - При системной установке: /var/lib/de_deploy-engine/env
DE_LOCAL_ENV_DIR=""

# Папка хранения архивов бэкапов (backup / restore):
# - Локально: <deploy-engine>/backup
# - При системной установке: /var/lib/de_deploy-engine/backup
DE_BACKUP_DIR=""

# Расположение движка на удаленном сервере по умолчанию (для полного режима --remote)
DE_REMOTE_ENGINE_DIR="/opt/de_deploy-engine"

# Системные пути целевой ОС по умолчанию (для Linux)
DE_SYS_BIN="/usr/local/bin"
DE_SYS_SYSTEMD="/etc/systemd/system"
DE_ENV_PATH="/etc/default"
DE_STATE_DIR="/var/lib"
DE_VENV_PATH="./.venv"
