# ==============================================================================
# Шаблон локальной конфигурации Deploy Engine (app.env)
# Скопируйте этот файл в deploy-engine/app.env для переопределения настроек
# в автономном режиме. Значение "#AUTO#" означает автоопределение под текущую ОС.
# ==============================================================================

# Базовый каталог динамических данных самого движка (#AUTO# -> локально папка движка, в prod — системный каталог)
DE_DATA_DIR="#AUTO#"

# Каталог репозитория пакетов по умолчанию (#AUTO# -> ./packages или <DE_DATA_DIR>/packages)
DE_PACKAGES_DIR="#AUTO#"

# Файл кэша реестра пакетов (#AUTO# -> packages.json или <DE_DATA_DIR>/packages.json)
DE_PACKAGES_CACHE="#AUTO#"

# Папка внутреннего хранилища локальных пресетов окружения (.env)
DE_LOCAL_ENV_DIR="#AUTO#"

# Папка хранения архивов бэкапов (backup / restore)
DE_BACKUP_DIR="#AUTO#"

# Расположение движка на удаленном сервере по умолчанию (для полного режима --remote)
DE_REMOTE_ENGINE_DIR="/opt/de_deploy-engine"

# Системные пути целевой ОС (#AUTO# -> автоматический подбор путей для Linux или macOS)
DE_SYS_BIN="#AUTO#"
DE_SYS_SYSTEMD="#AUTO#"
DE_ENV_PATH="#AUTO#"
DE_STATE_DIR="#AUTO#"
DE_OPT_DIR="#AUTO#"
DE_VENV_PATH="#AUTO#"
