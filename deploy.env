# ==============================================================================
# Конфигурация пакета deploy-engine (/etc/default/de_deploy-engine/deploy-engine.env)
# ==============================================================================

# Каталог динамических данных установленного движка
DE_DATA_DIR="/var/lib/de_deploy-engine"

# Каталог репозитория пакетов по умолчанию
DE_PACKAGES_DIR="/var/lib/de_deploy-engine/packages"

# Файл кэша реестра пакетов
DE_PACKAGES_CACHE="/var/lib/de_deploy-engine/packages.json"

# Каталог хранения локальных пресетов окружения (.env)
DE_LOCAL_ENV_DIR="/var/lib/de_deploy-engine/env"

# Каталог хранения архивов резервных копий (backup / restore)
DE_BACKUP_DIR="/var/lib/de_deploy-engine/backup"

# Путь к движку на удаленных серверах по умолчанию (для режима --remote)
DE_REMOTE_ENGINE_DIR="/opt/de_deploy-engine"

# Системные пути целевой ОС
DE_SYS_BIN="/usr/local/bin"
DE_SYS_SYSTEMD="/etc/systemd/system"
DE_ENV_PATH="/etc/default"
DE_STATE_DIR="/var/lib"
DE_VENV_PATH="/opt/de_deploy-engine/files/.venv"
