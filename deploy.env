# ==============================================================================
# Конфигурация пакета deploy-engine
# Linux / macOS (root): /etc/default/de_deploy-engine/deploy-engine.env
# macOS (user):         ~/.config/deploy-engine/default/de_deploy-engine/deploy-engine.env
# Значение "#AUTO#" означает автоматическое определение пути под текущую ОС.
# ==============================================================================

# Каталог динамических данных установленного движка
# (#AUTO# -> /var/lib/de_deploy-engine на Linux/root или ~/.local/state/deploy-engine/de_deploy-engine на macOS user)
DE_DATA_DIR="#AUTO#"

# Каталог репозитория пакетов по умолчанию (#AUTO# -> <DE_DATA_DIR>/packages)
DE_PACKAGES_DIR="#AUTO#"

# Файл кэша реестра пакетов (#AUTO# -> <DE_DATA_DIR>/packages.json)
DE_PACKAGES_CACHE="#AUTO#"

# Каталог внутреннего хранилища локальных пресетов окружения (.env)
# (#AUTO# -> <DE_DATA_DIR>/env)
DE_LOCAL_ENV_DIR="#AUTO#"

# Каталог хранения архивов резервных копий (backup / restore) (#AUTO# -> <DE_DATA_DIR>/backup)
DE_BACKUP_DIR="#AUTO#"

# Путь к движку на удаленных серверах по умолчанию (для режима --remote)
DE_REMOTE_ENGINE_DIR="/opt/de_deploy-engine"

# Системные пути целевой ОС (#AUTO# автоматически подбирает пути под Linux или macOS):
#   Linux:        bin=/usr/local/bin, systemd=/etc/systemd/system, env=/etc/default, state=/var/lib, opt=/opt
#   macOS (root): bin=/opt/homebrew/bin|/usr/local/bin, systemd=/Library/LaunchDaemons, env=/etc/default, state=/var/lib, opt=/opt
#   macOS (user): bin=/opt/homebrew/bin|~/.local/bin, systemd=~/Library/LaunchAgents, env=~/.config/deploy-engine/default, state=~/.local/state/deploy-engine, opt=~/.local/opt
DE_SYS_BIN="#AUTO#"
DE_SYS_SYSTEMD="#AUTO#"
DE_ENV_PATH="#AUTO#"
DE_STATE_DIR="#AUTO#"
DE_OPT_DIR="#AUTO#"
DE_VENV_PATH="#AUTO#"
